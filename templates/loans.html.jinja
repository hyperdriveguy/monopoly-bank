{% extends "sidebar.html.jinja" %}
{% block title %}Loans{% endblock %}
{% block content %}
<h2>Loans</h2>

<a href="{{ url_for('loan_application') }}" class="button">Apply for Loan</a>

{% if is_banker %}
<p>Loan Interest Rate: {{ (loan_interest_rate * 100)|int }}%</p>
{% endif %}

{% if loans %}
    {% set defaulted_loans = loans|selectattr('status.value', 'equalto', 'defaulted')|list %}
    {% set active_loans = loans|selectattr('status.value', 'equalto', 'active')|list %}
    {% set resolved_loans = loans|selectattr('status.value', 'equalto', 'resolved')|list %}
    {% set paid_off_loans = loans|selectattr('status.value', 'equalto', 'paid_off')|list %}
    
    {% if defaulted_loans %}
    <section class="overdue-section">
        <h3 style="color: #d32f2f; margin-top: 0;">Defaulted Loans ({{ defaulted_loans|length }})</h3>
        <div class="account-list">
            {% for loan in defaulted_loans %}
            <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable" style="border: 2px solid #d32f2f;">
                <article>
                    <h3 style="background-color: #d32f2f; color: white;">Loan #{{ loan.loan_id }}</h3>
                    {% if is_banker %}
                    <p>Borrower: {{ loan.borrower_id }}</p>
                    {% endif %}
                    <p>Status: <strong>DEFAULTED</strong></p>
                    <p>Principal: ${{ loan.principal }}</p>
                    <p>Interest: {{ (loan.interest_rate * 100)|int }}% ({% if loan.interest_compounds %}Compound{% else %}Simple{% endif %})</p>
                    <p style="color: #d32f2f;"><strong>Balance: ${{ loan.remaining_balance }}</strong></p>
                </article>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}
    
    {% if active_loans %}
    <h3 style="color: #1976d2; margin-top: 1.5em;">Active Loans ({{ active_loans|length }})</h3>
    <section class="account-list">
        {% set overdue_active = active_loans|selectattr('is_overdue')|list %}
        {% set on_time_active = active_loans|rejectattr('is_overdue')|list %}
        
        {% if overdue_active %}
        <div style="grid-column: 1 / -1; margin-bottom: 1.5em;">
            <h4 style="color: #ff9800;">Overdue ({{ overdue_active|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in overdue_active %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable overdue">
                    <article>
                        <h3 style="background-color: #ff9800; color: white;">Loan #{{ loan.loan_id }}</h3>
                        {% if is_banker %}
                        <p>Borrower: {{ loan.borrower_id }}</p>
                        {% endif %}
                        <p><strong style="color: #ff9800;">⚠ OVERDUE</strong></p>
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Interest: {{ (loan.interest_rate * 100)|int }}%</p>
                        <p>Balance: ${{ loan.remaining_balance }}</p>
                        <p><small>Min Payment: ${{ loan.minimum_payment }}</small></p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        {% if on_time_active %}
        <div style="grid-column: 1 / -1;">
            <h4 style="color: #4caf50;">On Time ({{ on_time_active|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in on_time_active %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable">
                    <article>
                        <h3>Loan #{{ loan.loan_id }}</h3>
                        {% if is_banker %}
                        <p>Borrower: {{ loan.borrower_id }}</p>
                        {% endif %}
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Interest: {{ (loan.interest_rate * 100)|int }}% ({% if loan.interest_compounds %}Compound{% else %}Simple{% endif %})</p>
                        {% if loan.is_due_this_turn %}
                        <p style="color: orange;"><strong>Payment due this turn!</strong></p>
                        {% endif %}
                        <p>Balance: ${{ loan.remaining_balance }}</p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </section>
    {% endif %}
    
    {% if resolved_loans %}
    <h3 style="color: #9c27b0; margin-top: 1.5em;">Resolved Defaults ({{ resolved_loans|length }})</h3>
    <section class="account-list">
        {% for loan in resolved_loans %}
        <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable">
            <article>
                <h3 style="background-color: #9c27b0; color: white;">Loan #{{ loan.loan_id }}</h3>
                {% if is_banker %}
                <p>Borrower: {{ loan.borrower_id }}</p>
                {% endif %}
                <p>Status: <strong>RESOLVED</strong></p>
                <p>Principal: ${{ loan.principal }}</p>
                <p>Paid: ${{ loan.amount_paid }} / ${{ loan.total_owed }}</p>
            </article>
        </a>
        {% endfor %}
    </section>
    {% endif %}
    
    {% if paid_off_loans %}
    <h3 style="color: #4caf50; margin-top: 1.5em;">Paid Off ({{ paid_off_loans|length }})</h3>
    <section class="account-list">
        {% for loan in paid_off_loans %}
        <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable">
            <article>
                <h3 style="background-color: #4caf50; color: white;">Loan #{{ loan.loan_id }}</h3>
                {% if is_banker %}
                <p>Borrower: {{ loan.borrower_id }}</p>
                {% endif %}
                <p>Status: <strong>PAID OFF ✓</strong></p>
                <p>Principal: ${{ loan.principal }}</p>
                <p>Total Paid: ${{ loan.amount_paid }}</p>
            </article>
        </a>
        {% endfor %}
    </section>
    {% endif %}
{% else %}
    <p style="margin: 2em 0;">No loans yet. <a href="{{ url_for('loan_application') }}">Apply for a loan</a></p>
{% endif %}

{% endblock content %}
