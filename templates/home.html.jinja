{% extends "sidebar.html.jinja" %}
{% block title %}Home{% endblock %}
{% block content %}
<h2>Home</h2>

<section>
    <h3>Game Status</h3>
    <p><strong>Current Turn: {{ current_turn }}</strong></p>
    {% if is_banker %}
    <form method="post" style="display: inline;">
        <button type="submit" name="increment-turn" value="true" style="padding: 8px 16px; font-size: 16px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer;">Increment Turn</button>
    </form>
    {% endif %}
</section>

{% if is_banker %}
<section>
    <h3>Banker Settings</h3>
    
    <h4>Mortgage Settings</h4>
    <form method="post">
        <label for="mortgage-interest">Mortgage Interest Rate (%):</label>
        <input type="number" id="mortgage-interest" name="mortgage-interest" min="0" max="100" step="1" value="{{ (mortgage_interest_rate * 100)|int }}" style="width: 80px;" required>
        <button type="submit">Update Rate</button>
    </form>
    <p>Current rate: {{ (mortgage_interest_rate * 100)|int }}%</p>
    
    <h4>Loan Settings</h4>
    <form method="post">
        <label for="loan-interest">Loan Interest Rate (%):</label>
        <input type="number" id="loan-interest" name="loan-interest" min="0" max="100" step="1" value="{{ (loan_interest_rate * 100)|int }}" style="width: 80px;" required>
        <button type="submit">Update Rate</button>
    </form>
    <p>Current loan rate: {{ (loan_interest_rate * 100)|int }}%</p>
    
    <form method="post">
        <label for="min-credit-score">Minimum Credit Score:</label>
        <input type="number" id="min-credit-score" name="min-credit-score" min="0" step="1" value="{{ min_credit_score }}" style="width: 100px;" required>
        <button type="submit">Update</button>
    </form>
    <p>Current minimum: {{ min_credit_score }}</p>
    
    <form method="post">
        <label for="max-loan-amount">Maximum Loan Amount ($):</label>
        <input type="number" id="max-loan-amount" name="max-loan-amount" min="1" step="1" value="{{ max_loan_amount }}" style="width: 100px;" required>
        <button type="submit">Update</button>
    </form>
    <p>Current maximum: ${{ max_loan_amount }}</p>
    
    <form method="post">
        <label for="compounding-interval">Compound Interest Every (turns):</label>
        <input type="number" id="compounding-interval" name="compounding-interval" min="1" step="1" value="{{ compounding_interval_turns }}" style="width: 100px;" required>
        <button type="submit">Update</button>
    </form>
    <p>Interest compounds every {{ compounding_interval_turns }} turns (during payment period)</p>
    
    <form method="post">
        <label for="default-payment-interval">Default Payment Interval (turns):</label>
        <input type="number" id="default-payment-interval" name="default-payment-interval" min="1" step="1" value="{{ default_payment_interval }}" style="width: 100px;" required>
        <button type="submit">Update</button>
    </form>
    <p>New loans have payments due every {{ default_payment_interval }} turns (unless customized)</p>
</section>
{% endif %}

{% endblock content %}
