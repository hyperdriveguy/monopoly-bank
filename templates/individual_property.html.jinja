{% extends "sidebar.html.jinja" %}
{% block title %}{{ prop.name }}{% endblock %}
{% block content %}
<h2 {% if prop.color %}style="background-color:{{ prop.color }};color:{% if prop.color != 'darkblue' %}black{% else %}#ddd{% endif %}"{% endif %}>{{ prop.name }}</h2>
<section class="{% if prop.mortgaged %}mortgaged{% endif %}">
    <p>Owner: {{ prop.owner if prop.owner else 'Bank' }}</p>
    {% if not prop.owner %}
        <p>Property cost: ${{ prop.costs['property'] }}</p>
    {% else %}
        <p class="rent-cost"><strong>Rent cost: ${{ prop.rent }}</strong></p>
        {% for item, cost in prop.costs.items() if item != 'property' %}
            <p>{{ item.title() }}: ${{ cost }}</p>
        {% endfor %}
    {% endif %}
    <p>Rent tiers:</p>
    {% for tier, rate in prop.rent_rates.items() %}
        <p>{{ tier }}: ${{ rate }}</p>
    {% endfor %}
</section>

{% if logged_in and prop.owner and prop.owner != user_id %}
<section>
    <h3>Pay Rent</h3>
    <form method="post">
        <input type="hidden" name="action" value="pay-rent">
        <p>Pay <strong>${{ prop.rent }}</strong> rent to {{ prop.owner }}</p>
        <button type="submit">Pay Rent</button>
    </form>
</section>
{% endif %}

{% if logged_in and prop.owner and prop.owner == user_id %}
<section>
    <h3>Property Owner Controls</h3>
    
    <h4>Create Auction</h4>
    <form method="post">
        <input type="hidden" name="action" value="create-auction">
        <div class="label-align">
            <label for="starting-bid">Starting Bid:</label>
            <input type="number" id="starting-bid" name="starting-bid" value="{{ (prop.costs['property'] * 0.5)|int }}" min="1" required>
        </div>
        <p><em>Suggested: ${{ (prop.costs['property'] * 0.5)|int }} (50% of property value)</em></p>
        <button type="submit">Create Auction</button>
    </form>
    
    <hr>
    
    <h4>Mortgage Management</h4>
    {% if prop.mortgaged %}
    <p class="warning-red">⚠ Property is MORTGAGED (no rent collected)</p>
    <form method="post">
        <input type="hidden" name="action" value="unmortgage">
        <p>Interest Rate: {{ (mortgage_interest_rate * 100)|int }}%</p>
        <p>Unmortgage cost: ${{ (prop.mortgage_value * (1 + mortgage_interest_rate))|int }}</p>
        <button type="submit">Unmortgage Property</button>
    </form>
    {% else %}
    <form method="post">
        <input type="hidden" name="action" value="mortgage">
        <p>Mortgage value: ${{ prop.mortgage_value }}</p>
        <button type="submit">Mortgage Property</button>
    </form>
    {% endif %}
</section>
{% endif %}

{% if is_banker %}
<section>
    <h3>Banker Controls</h3>
    {% if not prop.owner %}
    <form method="post">
        <label for="buyer-id">Sell to player:</label>
        <input type="text" id="buyer-id" name="buyer-id" placeholder="Player ID" required>
        <button type="submit">Sell Property</button>
    </form>
    {% else %}
    <h4>Buy Back Property</h4>
    <div class="buyback-grid">
        <form method="post">
            <input type="hidden" name="action" value="buy-back">
            <input type="hidden" name="fraction" value="0.25">
            <button type="submit">25% (${{ (prop.costs['property'] * 0.25)|int }})</button>
        </form>
        <form method="post">
            <input type="hidden" name="action" value="buy-back">
            <input type="hidden" name="fraction" value="0.5">
            <button type="submit">50% (${{ (prop.costs['property'] * 0.5)|int }})</button>
        </form>
        <form method="post">
            <input type="hidden" name="action" value="buy-back">
            <input type="hidden" name="fraction" value="0.75">
            <button type="submit">75% (${{ (prop.costs['property'] * 0.75)|int }})</button>
        </form>
        <form method="post">
            <input type="hidden" name="action" value="buy-back">
            <input type="hidden" name="fraction" value="1.0">
            <button type="submit">100% (${{ prop.costs['property'] }})</button>
        </form>
    </div>
    <form method="post" class="custom-buyback-form">
        <input type="hidden" name="action" value="buy-back">
        <label for="custom-fraction">Custom %:</label>
        <input type="number" id="custom-fraction" name="custom-fraction" min="0" max="200" step="1" placeholder="50" class="narrow-input">
        <button type="submit">Buy Back</button>
    </form>
    
    {% if prop.can_build %}
    <hr>
    <h4>Building Management</h4>
    <p>Current: {{ prop.building_level }}</p>
    {% if prop.owner_has_full_set(prop_manager) %}
    <p class="success-green">✓ Owner has full color set</p>
    {% else %}
    <p class="warning-orange">⚠ Warning: Owner does not have full color set</p>
    {% endif %}
    <div class="building-controls">
        <form method="post">
            <input type="hidden" name="action" value="add-building">
            <button type="submit">Add Building {% if 'house' in prop.costs %}(${{ prop.costs['houses'] }}){% endif %}</button>
        </form>
        <form method="post">
            <input type="hidden" name="action" value="remove-building">
            <button type="submit">Remove Building</button>
        </form>
    </div>
    {% endif %}
    {% endif %}
</section>
{% endif %}
{% endblock content %}
{% block scripts %}
{% endblock %}
