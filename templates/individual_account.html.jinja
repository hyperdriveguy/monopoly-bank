{% extends "sidebar.html.jinja" %}
{% block title %}Account - {{ acc.name }}{% endblock %}
{% block content %}
<h2>Account - {{ acc.name }}
{% if acc.banker %}
 - Banker
{% endif %}
</h2>
<p id="info">{{ info }}</p>
<p>ID: {{ acc.ident}}</p>
<p><strong>${{ acc.cash}}</strong></p>

{% if loans %}
    {% set defaulted_loans = loans|selectattr('status.value', 'equalto', 'defaulted')|list %}
    {% set overdue_loans = loans|selectattr('is_overdue')|list %}
    {% if defaulted_loans %}
    <div style="background-color: #ffebee; border: 2px solid #d32f2f; padding: 1em; margin: 1em 0; border-radius: 4px;">
        <p style="color: #d32f2f; font-weight: bold;">⚠️ ACCOUNT IN DEFAULT</p>
        <p>{{ defaulted_loans|length }} defaulted loan(s). Cannot apply for new loans until resolved.</p>
        <p><strong>Resolution Options:</strong></p>
        <ul style="margin: 0.5em 0; padding-left: 2em;">
            <li>Contact the banker to negotiate a settlement</li>
            <li>Pay off outstanding debt if you have sufficient cash</li>
            <li>Request a payment plan or restructuring</li>
        </ul>
        <a href="{{ url_for('loans_page') }}" style="display: inline-block; padding: 8px 16px; background-color: #d32f2f; color: white; text-decoration: none; border-radius: 4px; margin-top: 1em; cursor: pointer;">View Loans</a>
    </div>
    {% elif overdue_loans %}
    <div style="background-color: #fff3e0; border: 2px solid #ff9800; padding: 1em; margin: 1em 0; border-radius: 4px;">
        <p style="color: #ff9800; font-weight: bold;">⚠️ OVERDUE PAYMENTS</p>
        <p>{{ overdue_loans|length }} overdue loan(s). Make payments soon to avoid default.</p>
        <a href="{{ url_for('loans_page') }}" style="color: #ff9800; text-decoration: underline;">View Loans</a>
    </div>
    {% endif %}
{% endif %}

<div id="account-actions">
    {% if is_banker %}
    <button id="withdraw">Do Withdraw</button>
    <button id="deposit">Do Deposit</button>
    <button id="transfer">Do Transfer</button>
    {% endif %}
</div>

<!-- Credit Report Section (Banker Only) -->
{% if credit_info %}
<div style="background-color: #e8f5e9; border: 2px solid #4caf50; padding: 1em; margin: 1.5em 0; border-radius: 4px;">
    <h3 style="color: #2e7d32; margin-top: 0;">Credit Report</h3>
    <p><strong>Credit Score:</strong> <span style="font-size: 1.5em; color: #4caf50;">{{ credit_info.score }}</span></p>
    <p><strong>Rating:</strong> 
        <span style="display: inline-block; padding: 4px 12px; border-radius: 4px; 
                     background-color: {% if credit_info.rating == 'Excellent' %}#4caf50{% elif credit_info.rating == 'Good' %}#8bc34a{% elif credit_info.rating == 'Fair' %}#ff9800{% elif credit_info.rating == 'Poor' %}#ff5722{% else %}#d32f2f{% endif %};
                     color: white;">{{ credit_info.rating }}</span>
    </p>
    <a href="{{ url_for('credit_report_page', ident=acc.ident) }}" style="display: inline-block; padding: 8px 16px; background-color: #4caf50; color: white; text-decoration: none; border-radius: 4px; margin-top: 0.5em; cursor: pointer;">View Full Report</a>
</div>
{% endif %}
<div id="account-forms" class="wide-forms">
    <form action="" method="post" id="withdraw-form" class="card-stylize hidden">
        <h3>Withdraw</h3>
        <div class="label-align">
            <label for="withdraw-amount">$</label><input type="number" id="withdraw-amount" name="withdraw-amount" autofocus required>
        </div>
        <input type="submit" value="Submit">
    </form>
    <form action="" method="post" id="deposit-form" class="card-stylize hidden">
        <h3>Deposit</h3>
        <div class="label-align">
            <label for="deposit-amount">$</label><input type="number" id="deposit-amount" name="deposit-amount" autofocus required>
        </div>
        <input type="submit" value="Submit">
    </form>
    <form action="" method="post" id="transfer-form" class="card-stylize hidden">
        <h3>Do Transfer</h3>
        <input type="hidden" name="account-1-id" value="{{ acc.ident }}">
        <div class="label-align">
            <label for="account-2-id">Target account ID:</label><input type="text" id="account-2-id" name="account-2-id" placeholder="Target ID" required><br>
        </div>
        <div class="label-align">
            <label for="transfer-amount">$</label><input type="number" id="transfer-amount" name="transfer-amount" autofocus required>
        </div>
        <div class="radio">
            <input type="radio" id="transfer-1-2" name="transfer-direction" value="primary" checked="checked" required>
            <label for="transfer-1-2">Transfer to</label>
        </div>
        <div class="radio">
            <input type="radio" id="transfer-2-1" name="transfer-direction" value="reverse" required>
            <label for="transfer-2-1">Transfer from</label>
        </div>
        <input type="submit" value="Submit">
    </form>
</div>
<h3>Properties</h3>
<section class="account-list">
    {% for prop in acc.properties %}
    <a href="/properties/{{ prop.name }}" class="card-stylize clickable {% if prop.mortgaged %}mortgaged{% endif %}">
        <article>
            <h3 {% if prop.color %}style="background-color:{{ prop.color }};color:{% if prop.color != 'darkblue' %}black{% else %}#ddd{% endif %}"{% endif %}>{{ prop.name }}</h3>
            {% if not prop.owner %}
                <p>Owner: Bank</p>
                <p>Property cost: ${{ prop.costs['property'] }}</p>
            {% else %}
                <p>Owner: {{ prop.owner }}</p>
                <p>Rent cost: ${{ prop.rent }}</p>
            {% endif %}
            {% for item, cost in prop.costs.items() if item != 'property' %}
                <p>{{ item.title() }}: ${{ cost }}</p>
            {% endfor %}
            <p>Rent tiers:</p>
            <ul>
            {% for tier, rate in prop.rent_rates.items() %}
                <li>{{ tier }}: ${{ rate }}</li>
            {% endfor %}
            </ol>
        </article>
    </a>
    {% endfor %}
</section>

<h3>Loans</h3>
<section class="account-list">
    {% if loans %}
        {% set defaulted_loans = loans|selectattr('status.value', 'equalto', 'defaulted')|list %}
        {% set active_loans = loans|selectattr('status.value', 'equalto', 'active')|list %}
        {% set resolved_loans = loans|selectattr('status.value', 'equalto', 'resolved')|list %}
        {% set paid_off_loans = loans|selectattr('status.value', 'equalto', 'paid_off')|list %}
        
        {% if defaulted_loans %}
        <div style="grid-column: 1 / -1; margin-bottom: 1.5em;">
            <h4 style="color: #d32f2f; margin-top: 0;">Defaulted Loans ({{ defaulted_loans|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in defaulted_loans %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable" style="border: 2px solid #d32f2f;">
                    <article>
                        <h3 style="background-color: #d32f2f; color: white;">Loan #{{ loan.loan_id }}</h3>
                        <p><strong>Status:</strong> DEFAULTED</p>
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Interest: {{ (loan.interest_rate * 100)|int }}%</p>
                        <p style="color: #d32f2f;"><strong>Balance: ${{ loan.remaining_balance }}</strong></p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        {% if active_loans %}
        <div style="grid-column: 1 / -1; margin-bottom: 1.5em;">
            <h4 style="color: #1976d2; margin-top: 0;">Active Loans ({{ active_loans|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in active_loans %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable {% if loan.is_overdue %}overdue{% endif %}">
                    <article>
                        <h3 {% if loan.is_overdue %}style="background-color: #ff9800; color: white;"{% endif %}>Loan #{{ loan.loan_id }}</h3>
                        <p><strong>Status:</strong> ACTIVE</p>
                        {% if loan.is_overdue %}
                        <p style="color: #ff9800;"><strong>⚠ OVERDUE</strong></p>
                        {% endif %}
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Interest: {{ (loan.interest_rate * 100)|int }}%</p>
                        <p>Balance: ${{ loan.remaining_balance }} / ${{ loan.total_owed }}</p>
                        <p><small>Min Payment: ${{ loan.minimum_payment }}</small></p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        {% if resolved_loans %}
        <div style="grid-column: 1 / -1; margin-bottom: 1.5em;">
            <h4 style="color: #9c27b0; margin-top: 0;">Resolved Defaults ({{ resolved_loans|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in resolved_loans %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable">
                    <article>
                        <h3 style="background-color: #9c27b0; color: white;">Loan #{{ loan.loan_id }}</h3>
                        <p><strong>Status:</strong> RESOLVED</p>
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Paid: ${{ loan.amount_paid }} / ${{ loan.total_owed }}</p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        {% if paid_off_loans %}
        <div style="grid-column: 1 / -1; margin-bottom: 1.5em;">
            <h4 style="color: #4caf50; margin-top: 0;">Paid Off ({{ paid_off_loans|length }})</h4>
            <div class="account-list" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
                {% for loan in paid_off_loans %}
                <a href="{{ url_for('individual_loan_page', loan_id=loan.loan_id) }}" class="card-stylize clickable">
                    <article>
                        <h3 style="background-color: #4caf50; color: white;">Loan #{{ loan.loan_id }}</h3>
                        <p><strong>Status:</strong> PAID OFF ✓</p>
                        <p>Principal: ${{ loan.principal }}</p>
                        <p>Total Paid: ${{ loan.amount_paid }}</p>
                    </article>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    {% else %}
        <p>No loans. <a href="{{ url_for('loan_application') }}">Apply for a loan</a></p>
    {% endif %}
</section>

<section id="audit_log">
    <details>
        <summary>
            <h3>Audit Log</h3>
        </summary>
            <table>
            <thead>
                <tr>
                <th>Timestamp</th>
                <th>Type</th>
                <th>Info</th>
                </tr>
            </thead>
            <tbody>
                {% for timestamp, trans_type, trans_acc, trans_info in account_log %}
                <tr>
                    <td>{{ timestamp }}</td>
                    <td>{{ trans_type }}</td>
                    <td>{{ trans_info }}</td>
                </tr>
                {% endfor %}
            </tbody>
            </table>
    </details>
</section>
{% endblock content %}
{% block scripts %}
<script src="{{ url_for('static', filename='js/individual_account.js') }}"></script>
<!-- <script src="{{ url_for('static', filename='js/update_event.js') }}"></script> -->
{% endblock %}
